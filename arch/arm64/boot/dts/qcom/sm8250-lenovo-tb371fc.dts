/dts-v1/;

#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm8250.dtsi"
#include "pm8150.dtsi"

/ {
	chassis-type = "tablet";

	model = "Lenovo Xiaoxin Pad Pro 12.7 TB371FC";
	compatible = "lenovo,tb371fc", "qcom,sm8250";
	qcom,board-id = <0 0>;

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
	};

	vreg_s4a_1p8: pm8150-s4 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s4a_1p8";

		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		regulator-always-on;
		regulator-boot-on;

		vin-supply = <&vph_pwr>;
	};
};

&soc {
	/* What the driver uses it? */
	sim: simtray {
		compatible = "Lenovo,simtray-status";
		cd-gpios = <&tlmm 14 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * This node must be related to the `drivers/soc/qcom/serial_num.c`,
	 * though it's missing and likely will not work at all.
	 */
	sn_fuse: snfuse@786134 {
		compatible = "qcom,sn-fuse";
		reg = <0x786134 0x4>;
		reg-names = "sn-base";
	};

	/*
	 * `IPA` (IP Accelerator) is missing in `sm8250.dtsi`.
	 * The vendor disabled it in 4.19 kernel, but it is already not found
	 * in base dtsi.
	 * So, comment out and skip this node.
	 */

	// qcom,rmnet-ipa {
	// 	status = "disabled";
	// };

	/*
	 * `SLIMbus` (Serial Low-power Inter-chip Media Bus) is missing
	 * in `sm8250.dtsi`.
	 * Originally in 4.19 kernel, `huaqin,hardware_info` uses this node:
	 *
	 * ```
	 * &slim_aud {
	 *	hwinfo: HardwareInfo {
	 *		compatible = "huaqin,hardware_info";
	 *		status = "okay";
	 *	};
	 * };
	 * ```
	 *
	 * But it is not included into `sm8250.dtsi`.
	 * Should it be added manually like below?
	 */

	// slim: slim-ngd@3ac0000 {
	// 	compatible = "qcom,slim-ngd-v1.5.0";
	// 	reg = <0 0x03ac0000 0 0x2c000>;
	// 	interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
	// 	dmas = <&slimbam 3>, <&slimbam 4>;
	// 	dma-names = "rx", "tx";
	// 	iommus = <&apps_smmu 0x1826 0x0>;
	// 	#address-cells = <1>;
	// 	#size-cells = <0>;
	// 	status = "disabled";

	// 	hwinfo: HardwareInfo {
	// 		compatible = "huaqin,hardware_info";
	// 		status = "okay";
	// 	};
	// };
};

/*
 * `SDX55M` (High-Performance 5G Modem-RF System)
 *
 * Originally `mdm0` is defined in base `kona.dtsi` in 4.19 kernel
 * like below:
 *
 * ```
 * mdm0: qcom,mdm0 {
 * 	compatible = "qcom,ext-sdx55m";
 * 	...
 * };
 * ```
 *
 * It was disabled by vendor in 4.19 kernel, but it is already not found
 * in base `sm8250.dtsi`. So, likely it is not used at all
 * and nothing to do with it.
 */

// &mdm0 {
// 	status = "disabled";
// };

/*
 * START: ----------------------- PMIC regulators ------------------------------
 *
 * Original nodes from `tb371fc`:
 *
 *```
 * &apps_rsc {
 * 	rpmh-regulator-ldoc8 {
 * 		status = "ok";
 * 	};
 * 
 * 	rpmh-regulator-ldoc10 {
 * 		status = "ok";
 * 	};
 * };
 * 
 * &pm8150a_l1 {
 * 	regulator-always-on;
 * 	status = "ok";
 * };
 * 
 * &pm8150a_l8 {
 * 	regulator-always-on;
 * 	status = "ok";
 * };
 *```
 *
 * Note: original values from `kona-regulators.dtsi` in 4.19 kernel:
 * ```
 *   regulator-min-microvolt = <3000000>;
 *   regulator-max-microvolt = <3312000>;
 *   qcom,init-voltage = <3000000>;
 * ```
 *
 * So, the vendor increased the voltage from 3.0V to 3.312V for some unknown reason.
 */

// &pm8150a_l10 {
// 	qcom,init-mode = <RPMH_REGULATOR_MODE_HPM>;
// 	qcom,init-voltage = <3312000>;
// 	regulator-always-on;
// 	regulator-max-microvolt = <3312000>;
// 	regulator-min-microvolt = <3312000>;
// 	status = "ok";
// };

/*
 * To describe the same changes using the newer kernel's way,
 * we should look at the original structure of `kona-regulators.dtsi`
 * from 4.19 kernel first:
 *
 * ```
 * &apps_rsc {
 * 	rpmh-regulator-ldoc8 {
 * 		qcom,resource-name = "ldoc8";
 * 		qcom,regulator-type = "pmic5-ldo";
 * 		L8C: pm8150a_l8: regulator-pm8150a-l8 {
 * 			regulator-name = "pm8150a_l8";
 * 			qcom,set = <RPMH_REGULATOR_SET_ALL>;
 * 			regulator-min-microvolt = <1800000>;
 * 			regulator-max-microvolt = <1800000>;
 * 			qcom,init-voltage = <1800000>;
 * 		};
 * 	};
 * };
 * ```
 *
 * In the newer kernels quite likely the alternative must be looking like:
 * ```
 * &apps_rsc {
 *     regulators-0 {
 *         compatible = "qcom,pm8150-rpmh-regulators";
 *         qcom,pmic-id = "a";
 *     };
 * };
 * ```
 */

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8150-rpmh-regulators";
		qcom,pmic-id = "a";

		vdd-s1-supply = <&vph_pwr>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;
		vdd-s5-supply = <&vph_pwr>;
		vdd-s6-supply = <&vph_pwr>;
		vdd-s7-supply = <&vph_pwr>;
		vdd-s8-supply = <&vph_pwr>;
		vdd-s9-supply = <&vph_pwr>;
		vdd-s10-supply = <&vph_pwr>;

		vdd-l2-l10-supply = <&vreg_bob>;

		/* 
		 * LDO10 was 3.0V in base, 3.312V in vendor.
		 * Porting it exactly as vendor used.
		 */
		vreg_l10a_3p3: ldo10 {
			regulator-name = "vreg_l10a_3p3";
			regulator-min-microvolt = <3312000>;
			regulator-max-microvolt = <3312000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8150l-rpmh-regulators";
		qcom,pmic-id = "c";

		vdd-s1-supply = <&vph_pwr>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;
		vdd-s5-supply = <&vph_pwr>;
		vdd-s6-supply = <&vph_pwr>;
		vdd-s7-supply = <&vph_pwr>;
		vdd-s8-supply = <&vph_pwr>;

		vdd-l1-l8-supply = <&vreg_s4a_1p8>;

		vdd-bob-supply = <&vph_pwr>;

		vreg_bob: bob {
			regulator-name = "vreg_bob";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <3960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
		};

		/* Porting LDO1 and LDO8 which were marked always-on */
		vreg_l1a_1p8: ldo1 {
			regulator-name = "vreg_l1a_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		vreg_l8a_1p8: ldo8 {
			regulator-name = "vreg_l8a_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};
	};
};

/*
 * END: ------------------------ PMIC regulators -------------------------------
 */

/*
 * START: ---------------- QCA6390 (Wi-Fi 6 and Bluetooth 5.1) -----------------
 *
 * Originally defined in `kona.dtsi` in 4.19 kernel:
 *
 * ```
 * 	wlan: qcom,cnss-qca6390@b0000000 {
 * 		compatible = "qcom,cnss-qca6390";
 * 		...
 * 	};
 * ```
 *
 * But since `wlan` is not included in `sm8250.dtsi`, nothing can be
 * referenced in that way.
 * 
 */

// &wlan {
// 	vdd-wlan-dig-supply = <&pm8150_s6>;
// };

/*
 * END: ----------------- QCA6390 (Wi-Fi 6 and Bluetooth 5.1) ------------------
 */

/* 
 * START: ------------------------ PCIE1 wakeup-pin ----------------------------
 *
 * The original `tb371fc` nodes:
 *
 * ```
 * &pcie1 {
 * 	wake-gpio = <&tlmm 81 GPIO_ACTIVE_HIGH>;
 * };
 *
 * &pcie1_wake_default {
 * 	config {
 * 		/delete-property/ bias-pull-up;
 * 		pins = "gpio81";
 * 		bias-disable;
 * 	};
 *
 * 	mux {
 * 		pins = "gpio81";
 * 	};
 * };
 * ```
 *
 * As for the pcie1 pins, can be seen that vendor had changed the pins
 * to `gpio81`.
 *
 * The original `kona` pcie1 nodes are next:
 *
 * ``` qcom/kona-pinctrl.dtsi
 *
 * pcie1_wake_default: pcie1_wake_default {
 * 	mux {
 * 		pins = "gpio84";
 * 		function = "gpio";
 * 	};
 *
 * 	config {
 * 		pins = "gpio84";
 * 		drive-strength = <2>;
 * 		bias-pull-up;
 * 	};
 * };
 * ```
 * 
 * ``` qcom/kona-pcie.dtsi
 *
 * 	pcie1: qcom,pcie@1c08000 {
 * 		compatible = "qcom,pci-msm";
 * 		...
 * 		wake-gpio = <&tlmm 84 0>;
 * 	};
 * ```
 *
 * Can be clearly seen that vendor had changed the pins from `gpio84` to `gpio81`.
 *
 * So, making the same as vendor's modification:
 */

&pcie1 {
	wake-gpio = <&tlmm 81 GPIO_ACTIVE_HIGH>;
};

&pcie1_default_state {

	/*
	 * Actually, `tb371fc` released the original `gpio84` here, 
	 * for using with CTN73x (NFC Wireless Charging Transmitter)
	 * and re-using `gpio81` from `pcie0` for `pcie1`
	 */

	wake-pins {
		pins = "gpio81";
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

/*
 * As the conclusion, the vendor changed the pcie1 wakeup pin configuration
 * from `gpio84` to `gpio81` and make the `bias-pull-up` to `bias-disable`.
 *
 * Note, that the original `gpio81` is using for pcie0 wake up.
 *
 * END: ------------------------- PCIE1 wakeup-pin -----------------------------
 */

/*
 * Kept the original `pcie2` disable,
 * though it is already disabled by default in the `sm8250.dtsi`.
 */

&pcie2 {
	status = "disabled";
};

/*
 * START: ----------------- TLMM (Top Level Mode Multiplexer) ------------------
 */

&tlmm {
	/*
	 * The `pmx_sde` node in original `tb371fc` DTS was coming
	 * from `kona-pinctrl.dtsi` which used to setup
	 * `sde_dsi_active` / `sde_dsi_suspend` and
	 * `sde_dsi1_active` / `sde_dsi1_suspend`.
	 *
	 * Those nodes were occupying the `gpio75`, `gpio60`, and `gpio128`.
	 *
	 * And the vendor disabled it in their `tb371fc.dts`.
	 *
	 * ```
	 * /delete-node/ pmx_sde;
	 * ```
	 *
	 * At least the `gpio60` in the `qcom/kona-pinctrl.dtsi` in 4.19
	 * kernel is using for `sde_dsi` as well as `spi11/i2c11`.
	 * So, probably `sde_dsi` pins were freed for `spi11/i2c11`.
	 *
	 * Since the `sm8250.dtsi` uses `gpio60` only for spi11/i2c11, 
	 * probably it is no need to make any changes.
	 */

	/* 
	 * The next additions need to be converted.
	 *
	 * ```
	 * pmx_sde_bl {
	 *	sde_bl_active: sde_bl_active {
	 *		config {
	 *			pins = "gpio33", "gpio54", "gpio77", "gpio78";
	 *			drive-strength = <2>;   // 2 mA //
	 *			bias-pull-down;
	 *			output-high;
	 *		};
	 *
	 *		mux {
	 *			function = "gpio";
	 *			pins = "gpio33", "gpio54", "gpio77", "gpio78";
	 *		};
	 *	};
	 *
	 *	sde_bl_suspend: sde_bl_suspend {
	 *		config {
	 *			pins = "gpio33", "gpio54", "gpio77", "gpio78";
	 *			drive-strength = <2>;   // 2 mA //
	 *			bias-pull-down;
	 *			output-low;
	 *		};
	 *
	 *		mux {
	 *			pins = "gpio33", "gpio54", "gpio77", "gpio78";
	 *			function = "gpio";
	 *		};
	 *	};
	 * };
	 *
	 * nfc {
	 *	ctn730_int_default: ctn730_int_default {
	 *		config {
	 *			pins = "gpio84";
	 *			drive-strength = <2>;   // 2 mA //
	 *			bias-disable;
	 *			input-enable;
	 *		};
	 *		
	 *		mux {
	 *			pins = "gpio84";
	 *			function = "gpio";
	 *		};
	 *	};
	 * };
	 * ```
	 */

	/*
	 * Is `pmx_sde_bl` related to backlight?
	 *
	 * Note that `gpio78` is stolen from `cam2_default/rst-pins`.
	 */
	pmx_sde_bl {
		sde_bl_active: sde_bl_active {
			pins = "gpio33", "gpio54", "gpio77", "gpio78";
			function = "gpio";
			drive-strength = <2>;   // 2 mA //
			bias-pull-down;
			output-high;
		};

		sde_bl_suspend: sde_bl_suspend {
			pins = "gpio33", "gpio54", "gpio77", "gpio78";
			function = "gpio";
			drive-strength = <2>;   // 2 mA //
			bias-pull-down;
			output-low;
		};
	};

	/*
	 * CTN730 (NFC Wireless Charging Transmitter)
	 * The pin `gpio84` is stolen from `pcie1`
	 */
	nfc {
		ctn730_int_default: ctn730_int_default {
			pins = "gpio84";
			function = "gpio";
			drive-strength = <2>;   // 2 mA //
			bias-disable;
			input-enable;
		};
	};

	/* 
	 * In original `tb371fc` references `storage_cd` with only
	 * change of `pins` to `gpio14`.
	 * Since `sm8250.dtsi` has lack of such node, define it here fully.
	 */
	storage_cd {
		pins = "gpio14";
		function = "gpio";
		drive-strength = <2>;   // 2 mA //
		bias-pull-up;
	};

	/* 
	 * In original `tb371fc`, NFC related nodes below were
	 * referenced, but since in `sm8250.dtsi` they are not
	 * defined, so define them here fully.
	 */

	nfc_enable_active: nfc_enable_active {
		pins = "gpio25";
		function = "gpio";
		drive-strength = <2>;   // 2 mA //
		bias-pull-up;
	};

	nfc_enable_suspend: nfc_enable_suspend {
		pins = "gpio25";
		function = "gpio";
		drive-strength = <2>;   // 2 mA //
		bias-disable;
	};

	/*
	 * Note that the pin `gpio84` is stolen from `pcie1`.
	 */
	nfc_clk_req_active: nfc_clk_req_active {
		pins = "gpio84";
		function = "gpio";
		drive-strength = <2>;   // 2 mA //
		bias-pull-up;
	};

	/*
	 * Note that the pin `gpio84` is stolen from `pcie1`.
	 */
	nfc_clk_req_suspend: nfc_clk_req_suspend {
		pins = "gpio84";
		function = "gpio";
		drive-strength = <2>;   // 2 mA //
		bias-disable;
	};
};

/*
 * The nodes
 * - `cam_sensor_active_rst2`
 * - `cam_sensor_suspend_rst2`
 * - `cam_sensor_active_rgbleft`
 * - `cam_sensor_suspend_rgbleft`
 * were using `gpio78` in the `qcom/kona-pinctrl.dtsi` of 4.19 kernel,
 * but vendor changed them to `gpio93` in their `tb371fc.dts`.
 *
 * ```
 *	 &cam_sensor_active_rst2 {
 *	 	config {
 *	 		pins = "gpio93";
 *	 	};
 *	 
 *	 	mux {
 *	 		pins = "gpio93";
 *	 	};
 *	 };
 *	 &cam_sensor_suspend_rst2 {
 *	 	config {
 *	 		pins = "gpio93";
 *	 	};
 *	 
 *	 	mux {
 *	 		pins = "gpio93";
 *	 	};
 *	 };
 *	 
 *	 &cam_sensor_active_rgbleft {
 *	 	config {
 *	 		pins = "gpio93";
 *	 	};
 *	 
 *	 	mux {
 *	 		pins = "gpio93";
 *	 	};
 *	 };
 *	 
 *	 &cam_sensor_suspend_rgbleft {
 *	 	config {
 *	 		pins = "gpio93";
 *	 	};
 *	 
 *	 	mux {
 *	 		pins = "gpio93";
 *	 	};
 *	 };
 * ```
 *
 * In `sm8250.dtsi`, the nodes using `gpio78` are
 * `cam2_default` and `cam2_suspend`, so change exact only them
 */

&cam2_default {
	rst-pins {
		pins = "gpio93";
	};
};

&cam2_suspend {
	rst-pins {
		pins = "gpio93";
	};
};

/*
 * END: ----------------- TLMM (Top Level Mode Multiplexer) --------------------
 */

/*
 * What the alternative for setting `qmp-phy-init-seq`?
 */

// &usb_1_qmpphy {
// 	qcom,qmp-phy-init-seq = /* <reg_offset, value, delay> */
// 				<USB3_DP_QSERDES_COM_SSC_EN_CENTER 0x01 0
// 				 USB3_DP_QSERDES_COM_SSC_PER1 0x31 0
// 				 USB3_DP_QSERDES_COM_SSC_PER2 0x01 0
// 				 USB3_DP_QSERDES_COM_SSC_STEP_SIZE1_MODE0 0xDE 0
// 				 USB3_DP_QSERDES_COM_SSC_STEP_SIZE2_MODE0 0x07 0
// 				 USB3_DP_QSERDES_COM_SSC_STEP_SIZE1_MODE1 0xDE 0
// 				 USB3_DP_QSERDES_COM_SSC_STEP_SIZE2_MODE1 0x07 0
// 				 USB3_DP_QSERDES_COM_SYSCLK_BUF_ENABLE 0x0A 0
// 				 USB3_DP_QSERDES_COM_CMN_IPTRIM 0x20 0
// 				 USB3_DP_QSERDES_COM_CP_CTRL_MODE0 0x06 0
// 				 USB3_DP_QSERDES_COM_CP_CTRL_MODE1 0x06 0
// 				 USB3_DP_QSERDES_COM_PLL_RCTRL_MODE0 0x16 0
// 				 USB3_DP_QSERDES_COM_PLL_RCTRL_MODE1 0x16 0
// 				 USB3_DP_QSERDES_COM_PLL_CCTRL_MODE0 0x36 0
// 				 USB3_DP_QSERDES_COM_PLL_CCTRL_MODE1 0x36 0
// 				 USB3_DP_QSERDES_COM_SYSCLK_EN_SEL 0x1A 0
// 				 USB3_DP_QSERDES_COM_LOCK_CMP_EN 0x04 0
// 				 USB3_DP_QSERDES_COM_LOCK_CMP1_MODE0 0x14 0
// 				 USB3_DP_QSERDES_COM_LOCK_CMP2_MODE0 0x34 0
// 				 USB3_DP_QSERDES_COM_LOCK_CMP1_MODE1 0x34 0
// 				 USB3_DP_QSERDES_COM_LOCK_CMP2_MODE1 0x82 0
// 				 USB3_DP_QSERDES_COM_DEC_START_MODE0 0x82 0
// 				 USB3_DP_QSERDES_COM_DEC_START_MODE1 0x82 0
// 				 USB3_DP_QSERDES_COM_DIV_FRAC_START1_MODE0 0xAB 0
// 				 USB3_DP_QSERDES_COM_DIV_FRAC_START2_MODE0 0xEA 0
// 				 USB3_DP_QSERDES_COM_DIV_FRAC_START3_MODE0 0x02 0
// 				 USB3_DP_QSERDES_COM_DIV_FRAC_START1_MODE1 0xAB 0
// 				 USB3_DP_QSERDES_COM_DIV_FRAC_START2_MODE1 0xEA 0
// 				 USB3_DP_QSERDES_COM_DIV_FRAC_START3_MODE1 0x02 0
// 				 USB3_DP_QSERDES_COM_VCO_TUNE_MAP 0x02 0
// 				 USB3_DP_QSERDES_COM_VCO_TUNE1_MODE0 0x24 0
// 				 USB3_DP_QSERDES_COM_VCO_TUNE1_MODE1 0x24 0
// 				 USB3_DP_QSERDES_COM_VCO_TUNE2_MODE1 0x02 0
// 				 USB3_DP_QSERDES_COM_HSCLK_SEL 0x01 0
// 				 USB3_DP_QSERDES_COM_CORECLK_DIV_MODE1 0x08 0
// 				 USB3_DP_QSERDES_COM_BIN_VCOCAL_CMP_CODE1_MODE0 0xCA 0
// 				 USB3_DP_QSERDES_COM_BIN_VCOCAL_CMP_CODE2_MODE0 0x1E 0
// 				 USB3_DP_QSERDES_COM_BIN_VCOCAL_CMP_CODE1_MODE1 0xCA 0
// 				 USB3_DP_QSERDES_COM_BIN_VCOCAL_CMP_CODE2_MODE1 0x1E 0
// 				 USB3_DP_QSERDES_COM_BIN_VCOCAL_HSCLK_SEL 0x11 0
// 				 USB3_DP_QSERDES_TXA_RES_CODE_LANE_TX 0x60 0
// 				 USB3_DP_QSERDES_TXA_RES_CODE_LANE_RX 0x60 0
// 				 USB3_DP_QSERDES_TXA_RES_CODE_LANE_OFFSET_TX 0x11 0
// 				 USB3_DP_QSERDES_TXA_RES_CODE_LANE_OFFSET_RX 0x02 0
// 				 USB3_DP_QSERDES_TXA_TX_DRV_LVL 0x3f 0x0  /* added */
// 				 USB3_DP_QSERDES_TXA_TX_EMP_POST1_LVL 0x37 0x0  /* added */
// 				 USB3_DP_QSERDES_TXA_LANE_MODE_1 0xD5 0
// 				 USB3_DP_QSERDES_TXA_LANE_MODE_2 0x00 0
// 				 USB3_DP_QSERDES_TXA_RCV_DETECT_LVL_2 0x12 0
// 				 USB3_DP_QSERDES_TXA_PI_QEC_CTRL 0x40 0
// 				 USB3_DP_QSERDES_RXA_UCDR_FO_GAIN 0x09 0
// 				 USB3_DP_QSERDES_RXA_UCDR_SO_GAIN 0x05 0
// 				 USB3_DP_QSERDES_RXA_UCDR_FASTLOCK_FO_GAIN 0x2F 0
// 				 USB3_DP_QSERDES_RXA_UCDR_SO_SATURATION_AND_ENABLE 0x7F 0
