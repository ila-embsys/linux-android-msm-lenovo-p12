// 				 0xffffffff 0xffffffff 0x00>;
// };

/*
 * START: --------------- MDSS (Mobile Display Subsystem) ----------------------
 *
 * The original vendor's DTS for `tb371fc` has the following node:
 *
 * ```
 * &mdss_mdp {
 * 	clock-rate = <0 0 0 0 460000000 19200000 300000000 19200000>;
 * };
 * ```
 *
 * The original upstream `kona` node of 4.19 kernel has:
 *
 * ```
 * &soc {
 *	mdss_mdp: qcom,mdss_mdp@ae00000 {
 *		compatible = "qcom,sde-kms";
 *		...
 *		clocks =
 *			<&clock_gcc GCC_DISP_AHB_CLK>,
 *			<&clock_gcc GCC_DISP_HF_AXI_CLK>,
 *			<&clock_gcc GCC_DISP_SF_AXI_CLK>,
 *			<&clock_dispcc DISP_CC_MDSS_AHB_CLK>,
 *			<&clock_dispcc DISP_CC_MDSS_MDP_CLK>,
 *			<&clock_dispcc DISP_CC_MDSS_VSYNC_CLK>,
 *			<&clock_dispcc DISP_CC_MDSS_MDP_LUT_CLK>,
 *			<&clock_dispcc DISP_CC_MDSS_ROT_CLK>;
 *		clock-names = "gcc_iface", "gcc_bus", "gcc_nrt_bus",
 *				"iface_clk", "core_clk", "vsync_clk",
 *				"lut_clk", "rot_clk";
 *		clock-rate = <0 0 0 0 300000000 19200000 300000000 19200000>;
 *		clock-max-rate = <0 0 0 0 460000000 19200000 460000000
 *					460000000>;
 *	};
 * };
 * ```
 *
 * Quite likely the change for `tb371fc` was made to increase the MDP core clock rate
 * from 300MHz to 460MHz:
 *
 * The new DTS node has split description:
 * ```
 * mdss: display-subsystem@ae00000 {
 * 	compatible = "qcom,sm8250-mdss";
 * 	...
 * 	clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
 * 			<&gcc GCC_DISP_HF_AXI_CLK>,
 * 			<&gcc GCC_DISP_SF_AXI_CLK>,
 * 			<&dispcc DISP_CC_MDSS_MDP_CLK>;
 * 	clock-names = "iface", "bus", "nrt_bus", "core";
 * 	...
 * 	mdss_mdp: display-controller@ae01000 {
 * 		compatible = "qcom,sm8250-dpu";
 * 		...
 * 		clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
 * 				<&gcc GCC_DISP_HF_AXI_CLK>,
 * 				<&dispcc DISP_CC_MDSS_MDP_CLK>,
 * 				<&dispcc DISP_CC_MDSS_VSYNC_CLK>;
 * 		clock-names = "iface", "bus", "core", "vsync";
 * 
 * 		assigned-clocks = <&dispcc DISP_CC_MDSS_VSYNC_CLK>;
 * 		assigned-clock-rates = <19200000>;
 * 		...
 * 	};
 * };
 * ```
 *
 * So, quite likely the new `assigned-clocks` and `assigned-clock-rates`
 * should be added to the `mdss_mdp` node.
 *
 */

&mdss_mdp {
	assigned-clocks = <&dispcc DISP_CC_MDSS_VSYNC_CLK &dispcc DISP_CC_MDSS_MDP_CLK>;
	assigned-clock-rates = <19200000 460000000>;
};

&mdss_dsi0_phy {

	/* 
	 * What the alternative?
	 * It was in 4.19 but not available here
	 * The vendor changed the last line
	 * `00 00 8a 8a` to `20 00 8a 8a`.
	 */

	// qcom,platform-lane-config = [00 00 0a 0a
	// 			     00 00 0a 0a
	// 			     00 00 0a 0a
	// 			     00 00 0a 0a
	// 			     20 00 8a 8a];
};

&mdss_dsi1_phy {

	/* 
	 * What the alternative?
	 * It was in 4.19 but not available here
	 * The vendor changed the last line
	 * `00 00 8a 8a` to `20 00 8a 8a`.
	 */

	// qcom,platform-lane-config = [00 00 0a 0a
	// 			     00 00 0a 0a
	// 			     00 00 0a 0a
	// 			     00 00 0a 0a
	// 			     20 00 8a 8a];
};

/* 
 * END: ----------------- MDSS (Mobile Display Subsystem) ----------------------
 */

/* 
 * START: ----------------- CCI (Camera Control Interface) ----------------------
 *
 * Originally, the matching external `kona-camera.dtsi`
 * for the `tb371fc` uses two nodes, each of them
 * using two pairs of I2C lines (indexes 0 and 1 for the first CCI and
 * indexes 2 and 3 for the second CCI).
 *
 * ```
 * cam_cci0: qcom,cci@ac4f000 {
 * 	compatible = "qcom,cci";
 * 	pinctrl-0 = <&cci0_active &cci1_active>;
 * 	pinctrl-1 = <&cci0_suspend &cci1_suspend>;
 * 	gpios = <&tlmm 101 0>,
 * 		<&tlmm 102 0>,
 * 		<&tlmm 103 0>,
 * 		<&tlmm 104 0>;
 * 	gpio-req-tbl-num = <0 1 2 3>;
 * 	gpio-req-tbl-flags = <1 1 1 1>;
 * 	gpio-req-tbl-label = "CCI_I2C_DATA0",
 * 			     "CCI_I2C_CLK0",
 * 			     "CCI_I2C_DATA1",
 * 			     "CCI_I2C_CLK1";
 * };
 * 
 * cam_cci1: qcom,cci@ac50000 {
 * 	compatible = "qcom,cci";
 * 	pinctrl-0 = <&cci2_active &cci3_active>;
 * 	pinctrl-1 = <&cci2_suspend &cci3_suspend>;
 * 	gpios = <&tlmm 105 0>,
 * 		<&tlmm 106 0>,
 * 		<&tlmm 107 0>,
 * 		<&tlmm 108 0>;
 * 	gpio-req-tbl-num = <0 1 2 3>;
 * 	gpio-req-tbl-flags = <1 1 1 1>;
 * 	gpio-req-tbl-label = "CCI_I2C_DATA2",
 * 			     "CCI_I2C_CLK2",
 * 			     "CCI_I2C_DATA3",
 * 			     "CCI_I2C_CLK3";
 * };
 * ```
 *
 * But the vendor changed it to use only one pair of I2C lines per each CCI.
 *
 * However, the CCI1 description starts from second pair of I2C lines (indexes 2 and 3),
 * but uses the only one (index 2).
 *
 *
 * ```
 * Original `tb371fc` nodes:
 * &cam_cci0 {
 * 	pinctrl-0 = <&cci0_active>;
 * 	pinctrl-1 = <&cci0_suspend>;
 * 	gpios = <&tlmm 101 GPIO_ACTIVE_HIGH>,
 * 		<&tlmm 102 GPIO_ACTIVE_HIGH>;
 * 	gpio-req-tbl-num = <0 1>;
 * 	gpio-req-tbl-flags = <1 1>;
 * 	gpio-req-tbl-label = "CCI_I2C_DATA0", "CCI_I2C_CLK0";
 * };
 * 
 * &cam_cci1 {
 * 	pinctrl-0 = <&cci2_active>;
 * 	pinctrl-1 = <&cci2_suspend>;
 * 	gpios = <&tlmm 105 GPIO_ACTIVE_HIGH>,
 * 		<&tlmm 106 GPIO_ACTIVE_HIGH>;
 * 	gpio-req-tbl-num = <0 1>;
 * 	gpio-req-tbl-flags = <1 1>;
 * 	gpio-req-tbl-label = "CCI_I2C_DATA2", "CCI_I2C_CLK2";
 * };
 * ```
 *
 * The `sm8250.dtsi` already describes the pins the same way.
 * Note 101, 102 and 105, 106:
 * ```
 * cci0_default: cci0-default-state {
 * 	cci0_i2c0_default: cci0-i2c0-default-pins {
 * 		pins = "gpio101", "gpio102";
 * 	};
 * 
 * 	cci0_i2c1_default: cci0-i2c1-default-pins {
 * 		pins = "gpio103", "gpio104";
 * 	};
 * };
 * 
 * cci1_default: cci1-default-state {
 * 	cci1_i2c0_default: cci1-i2c0-default-pins {
 * 		pins = "gpio105","gpio106";
 * 	};
 * 
 * 	cci1_i2c1_default: cci1-i2c1-default-pins {
 * 		pins = "gpio107","gpio108";
 * 	};
 * };
 * ```
 *
 * Also, the `sm8250.dtsi` describes per two pairs of I2C buses:
 * 
 * ```
 * cci0: cci@ac4f000 {
 * 	compatible = "qcom,sm8250-cci", "qcom,msm8996-cci";
 * 
 * 	cci0_i2c0: i2c-bus@0 {
 * 		...
 * 	};
 * 
 * 	cci0_i2c1: i2c-bus@1 {
 * 		...
 * 	};
 * };
 * 
 * 
 * cci1: cci@ac50000 {
 * 	compatible = "qcom,sm8250-cci", "qcom,msm8996-cci";
 * 
 * 	cci1_i2c0: i2c-bus@0 {
 * 		...
 * 	};
 * 
 * 	cci1_i2c1: i2c-bus@1 {
 * 		...
 * 	};
 * };
 *```
 *
 * So, as originally the vendor released every second pair of gpios
 * and every second I2C bus for CCI0 and CCI1, let's do the same:
 */

&cci0_default {
	/delete-node/ cci0-i2c1-default-pins;
};

&cci0_sleep {
	/delete-node/ cci0-i2c1-sleep-pins;
};

&cci1_default {
	/delete-node/ cci1-i2c1-default-pins;
};

&cci1_sleep {
	/delete-node/ cci1-i2c1-sleep-pins;
};

&cci0 {
	/delete-node/ i2c-bus@1;
};

&cci1 {
	/delete-node/ i2c-bus@1;
};

/*
 * END: ------------------- CCI (Camera Control Interface) ---------------------
 */

&i2c15 {
	status = "ok";

	/*
	 * This node was deleted in vendor DTS,
	 * but since it also not exists in base `sm8250.dtsi`,
	 * it will have no effect.
	 */
	// /delete-node/ fsa4480@43;

	/*
	 * START: ------------- NXP TFA98xx Smart Amp --------------------------
	 * 
	 * Originally in 4.19 kernel the `compatible`
	 * was `tfa,tfa98xx`, but in newer kernels it's changed
	 * to be more specific.
	 *
	 * TODO:
	 *     It must be chosen:
	 *       - nxp,tfa9890
	 *       - nxp,tfa9895
	 *       - nxp,tfa9897
	 */

	// tfa98xx@34 {
	// 	compatible = "tfa,tfa98xx";
	// 	reg = <0x34>;
	// 	reset-gpio = <&tlmm 0x73 GPIO_ACTIVE_HIGH>;
	// };

	// tfa98xx@35 {
	// 	compatible = "tfa,tfa98xx";
	// 	reg = <0x35>;
	// 	reset-gpio = <&tlmm 0x75 GPIO_ACTIVE_HIGH>;
	// };

	// tfa98xx@36 {
	// 	compatible = "tfa,tfa98xx";
	// 	reg = <0x36>;
	// 	reset-gpio = <&tlmm 0x76 GPIO_ACTIVE_HIGH>;
	// };

	// tfa98xx@37 {
	// 	compatible = "tfa,tfa98xx";
	// 	reg = <0x37>;
	// 	reset-gpio = <&tlmm 0x74 GPIO_ACTIVE_HIGH>;
	// };

	/*
	 * END: --------------- NXP TFA98xx Smart Amp -------------------------- 
	 */
};

&i2c19 {
	status = "ok";

	/*
	 * START: ------- FSA4480 - USB Type-C Analog Audio Switch -------------
	 *
	 * Original `tb371fc` node from 4.19 kernel:
	 *
	 * ```
	 *     fsa4480: fsa4480@42 {
	 *         compatible = "qcom,fsa4480";
	 *         reg = <0x42>;
	 *     };
	 * ```
	 *
	 * But in newer kernels the node was modified to:
	 *     compatible = "fsa,fsa4480";
	 *
	 * Moreover it requires at least:
	 * ```
	 * required:
	 *   - compatible
	 *   - reg
	 *   - port
	 * ```
	 *
	 * But, the `port` property must be pointing to the Type C port like below:
	 *
	 * ```
	 * &pm8150_typec {
	 *	 status = "okay";
	 *	 connector {
	 *	 	compatible = "usb-c-connector";
	 *	 	ports {
	 *	 		...
	 *	 		port@2 {
	 *	 			reg = <2>;
	 *	 			pm8150_typec_sbu_out: endpoint {
	 *	 				remote-endpoint = <&fsa4480_sbu_mux>;
	 *	 			};
	 *	 		};
	 *	 	};
	 *	 };
	 * };
	 * ```
	 *
	 * But it is not available in base `pm8150.dtsi`
	 */

	// TODO: enable when remote port will be available

	// typec-mux@42 {
	// 	compatible = "fsa,fsa4480";
	// 	reg = <0x42>;

	// 	port {
	// 		fsa4480_sbu_mux: endpoint {
	// 			remote-endpoint = <&pm8150_typec_sbu_out>;
	// 		};
	// 	};
	// };

	/*
	 * END: ------- FSA4480 - USB Type-C Analog Audio Switch ---------------
	 */
};

&spi14 {
	status = "ok";
};

/*
 * START: --- Time Division Multiplexed (TDM) Digital Audio Interface (DAI) ----
 *
 * Originally in `tb371fc` for 4.19 the vendor made next:
 * 
 * ```
 * &tdm_pri_rx {
 * 	qcom,msm-cpudai-tdm-clk-rate = <6144000>;
 * 	qcom,msm-cpudai-tdm-sync-mode = <0>;
 * };
 * 
 * &tdm_pri_tx {
 * 	qcom,msm-cpudai-tdm-clk-rate = <6144000>;
 * 	qcom,msm-cpudai-tdm-sync-mode = <0>;
 * };
 * ```
 * The defalt values from `qcom/msm-audio-lpass.dtsi`:
 * ```
 * 	tdm_pri_rx: qcom,msm-dai-tdm-pri-rx {
 * 		compatible = "qcom,msm-dai-tdm";
 * 		...
 * 		qcom,msm-cpudai-tdm-clk-rate = <1536000>;
 * 		...
 * 		qcom,msm-cpudai-tdm-sync-mode = <1>;
 * 	};
 * 	tdm_pri_tx: qcom,msm-dai-tdm-pri-tx {
 * 		compatible = "qcom,msm-dai-tdm";
 *		...
 * 		qcom,msm-cpudai-tdm-clk-rate = <1536000>;
 * 		...
 * 		qcom,msm-cpudai-tdm-sync-mode = <1>;
 *	};
 * ```
 *
 * So the vendor increased Clock Rate by 4 times (1.536 MHz * 4 = 6.144 MHz)
 * and changed Sync Mode from Long (1) to Short (0).
 *
 * Clock Rate = 6144000 = 1536000 * 4
 * Sync Mode = 0 = Short sync bit mode << vendor used
 * Sync Mode = 1 = Long sync mode << base
 */

&q6afedai {
	qcom,tdm-sync-mode = <0>;
};

/*
 * Probably the setting of clock rate is non needed any more:
 *
 * AI overview:
 *   - the consumer node (like a DAI link) references the clock, 
 *     and the driver code handles the scaling via clk_set_rate 
 *     based on the audio sample rate
 */

/*
 * END: --- Time Division Multiplexed (TDM) Digital Audio Interface (DAI) ------
 */

&{/reserved-memory} {
	bootlog_mem: boot_log_region@0 {
		compatible = "removed-dma-pool";
		no-map;
		reg = <0x0 0xb0000000 0x0 0x80000>;
	};
};
